{
    "name": "personal-website",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "blog:fetch": "node scripts/fetch-medium.mjs",
        "data:fetch": "node scripts/fetch-medium.mjs && node scripts/fetch-thunderstore.mjs",
        "predev": "npm run data:fetch",
        "prebuild": "npm run data:fetch",
        "pretypecheck": "npm run data:fetch",
        "dev": "next dev",
        "build": "next build && node scripts/fix-export-paths.mjs",
        "test:export": "node --test tests/fix-export-paths.test.mjs",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
        "test:html": "node --test tests/built-site/*.test.mjs",
        "photos": "node scripts/build-photos.mjs",
        "photos:commit": "node scripts/photo-commit.mjs",
        "social-card": "node scripts/build-social-card.mjs"
    },
    "dependencies": {
        "next": "16.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "sharp": "0.35.5",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=22.18"
    }
}
