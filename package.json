{
    "name": "personal-website",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "blog:fetch": "node scripts/fetch-medium.mjs",
        "predev": "node scripts/fetch-medium.mjs && node scripts/fetch-thunderstore.mjs",
        "prebuild": "node scripts/fetch-medium.mjs && node scripts/fetch-thunderstore.mjs",
        "pretypecheck": "node scripts/fetch-medium.mjs && node scripts/fetch-thunderstore.mjs",
        "dev": "next dev",
        "build": "next build && node scripts/fix-export-paths.mjs",
        "test:export": "node --test scripts/fix-export-paths.test.mjs",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "node --test scripts/theme.test.mjs scripts/fix-export-paths.test.mjs scripts/medium.test.mjs scripts/resume.test.mjs scripts/deploy-config.test.mjs scripts/thunderstore.test.mjs",
        "test:html": "node --test scripts/export-html.test.mjs"
    },
    "dependencies": {
        "next": "16.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=22"
    }
}
